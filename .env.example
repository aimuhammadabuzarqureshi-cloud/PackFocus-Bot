# ─── Gemini API Configuration ──
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OpenRouter Configuration (Fallback Model) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ─── Server Configuration ──
PORT=3000
HOST=0.0.0.0

# ─── Company & Domain Context ──
COMPANY_NAME=PackVibe Solutions
COMPANY_DESCRIPTION=We are a premium custom packaging company specializing in boxes, mailers, and shipping packages.
PRODUCT_CATALOG=Custom Mailer Boxes, Shipping Boxes, Product Gift Boxes, Kraft Boxes, Cardboard Packaging, Custom Tape, Tissue Paper

# ─── Email Notification Config ──
COMPANY_EMAIL=info@packvibesolutions.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-smtp-app-password

# ─── Voice / Text-to-Speech (TTS) Engines (Optional) ──
SMALLEST_API_KEY=
SMALLEST_VOICE_ID=meher
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
OPENAI_API_KEY=
OPENAI_VOICE=nova
